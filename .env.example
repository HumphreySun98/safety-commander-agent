# Copy this file to .env and fill in the values (the hackathon endpoint is in the brief).
VLLM_BASE_URL=http://89.169.112.191:8080/v1
VLLM_KEY=sk-your-key-here
VLLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8

